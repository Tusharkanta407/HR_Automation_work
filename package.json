{
  "name": "hr-automation",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/db"
  ],
  "scripts": {
    "postinstall": "npm run generate -w @hr-automation/db",
    "generate": "npm run generate -w @hr-automation/db",
    "build": "npm run build -w web",
    "vercel-build": "npm run generate -w @hr-automation/db && npm run build -w web",
    "dev:web": "npm run dev -w web"
  },
  "engines": {
    "node": ">=20"
  }
}
