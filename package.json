{
  "name": "hr-automation",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/worker",
    "packages/db",
    "packages/google-workspace",
    "packages/queue",
    "packages/workflow-engine"
  ],
  "scripts": {
    "postinstall": "npm run generate -w @hr-automation/db",
    "generate": "npm run generate -w @hr-automation/db",
    "build": "npm run build -w web",
    "ensure-lightningcss": "node scripts/ensure-lightningcss.mjs",
    "vercel-build": "npm run ensure-lightningcss && npm run generate -w @hr-automation/db && npm run build -w web",
    "dev:web": "npm run dev -w web",
    "dev:worker": "npm run dev -w @hr-automation/worker"
  },
  "engines": {
    "node": ">=20"
  }
}
