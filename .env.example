# Shared local environment (copy to .env — do not commit secrets)
# Next.js also needs these in apps/web/.env.local (Next only loads env from the app folder)

# Neon PostgreSQL
# Neon Console → Connection Details
# Prefer pooled URL for Next.js serverless; direct URL is fine for the long-running worker
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Optional: non-pooled / direct for migrations or worker if you split URLs
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Encrypt IntegrationCredential.encryptedData (min 16 chars). Never commit the real value.
# Alias also accepted: CREDENTIAL_ENCRYPTION_KEY
# Generate: openssl rand -base64 32
CREDENTIALS_SECRET=replace-with-a-long-random-string

# Redis / BullMQ (local Docker) — required for Run Now → worker
# Start: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Demo HR API for Connections "Demo (our API)" option (server resolves this; do not trust client)
DEMO_HR_API_BASE_URL=https://hr-automation-work.onrender.com
# Optional public label in UI (falls back to DEMO_HR_API_BASE_URL)
NEXT_PUBLIC_DEMO_HR_API_URL=https://hr-automation-work.onrender.com

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth: NextAuth + Google OAuth
# Generate secret: openssl rand -base64 32
#
# LOCAL:
NEXTAUTH_URL=http://localhost:3000
#
# VERCEL (Production) — MUST be your live site, NOT localhost:
# NEXTAUTH_URL=https://hr-automation-work-web.vercel.app
NEXTAUTH_SECRET=replace-with-a-long-random-string
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URIs (add ALL you use):
#   http://localhost:3000/api/auth/callback/google
#   https://hr-automation-work-web.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Workspace connection (Gmail / Drive / Sheets) — can reuse login client or a dedicated one
# Authorized redirect URI: {NEXTAUTH_URL}/api/integrations/google/callback
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# Worker
WORKER_CONCURRENCY=1
WORKER_ID=worker-1
# Optional: DB poll interval when Redis is down (ms)
# WORKER_POLL_MS=3000
