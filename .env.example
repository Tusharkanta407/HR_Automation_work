# Shared local environment (copy to .env — do not commit secrets)

# PostgreSQL
DATABASE_URL=postgresql://hr:hr@localhost:5432/hr_automation
POSTGRES_USER=hr
POSTGRES_PASSWORD=hr
POSTGRES_DB=hr_automation

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# .NET HR mock API
HR_API_BASE_URL=http://localhost:5080

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Google OAuth (fill when auth is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker
WORKER_CONCURRENCY=1
WORKER_ID=worker-1
